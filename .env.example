# Spring profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_DB=scribeai
POSTGRES_USER=scribeai
POSTGRES_PASSWORD=scribeai
POSTGRES_PORT=5432

# App server
SERVER_PORT=8080
MULTIPART_MAX_FILE_SIZE=200MB
MULTIPART_MAX_REQUEST_SIZE=200MB
YTDLP_COMMAND=/usr/local/bin/yt-dlp
YTDLP_JS_RUNTIME=node
YTDLP_EXTRA_PATH=/opt/homebrew/bin:/usr/local/bin
YTDLP_ERROR_MESSAGE_MAX_LENGTH=2000
YTDLP_SUBTITLE_LANGS=ko,en,es

# STT provider
STT_PROVIDER=openai
OPENAI_API_KEY=
STT_OPENAI_BASE_URL=https://api.openai.com/v1
STT_OPENAI_MODEL=whisper-1
STT_OPENAI_LANGUAGE=ko

# Summary provider
SUMMARY_PROVIDER=mock
SUMMARY_OUTPUT_LANGUAGE=ko
SUMMARY_DEFAULT_MODE=AUTO
# SUMMARY_OPENAI_BASE_URL=https://api.openai.com/v1
# SUMMARY_OPENAI_MODEL=gpt-4o-mini
# SUMMARY_OPENAI_TEMPERATURE=0.2

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=5
RAG_EMBEDDING_PROVIDER=mock
RAG_CLEANUP_ENABLED=true
RAG_RETENTION_MINUTES=120
RAG_CLEANUP_INTERVAL_MS=1200000
RAG_CLEANUP_INITIAL_DELAY_MS=60000
RAG_ANSWER_PROVIDER=mock
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_ANSWER_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_ANSWER_OPENAI_MODEL=gpt-4o-mini
# RAG_ANSWER_OPENAI_TEMPERATURE=0.2
